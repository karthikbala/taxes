# Standalone Node server. setup:local generates an ignored .env.local.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
TAXES_DB_PATH=./runtime/taxes.sqlite
INVISIA_POC_API_KEY=replace-with-a-random-secret
INVISIA_BROWSER_ENABLED=0
# INVISIA_BROWSER_API_KEY=provision-securely-only-after-source-budget-approval
# Explicit staging operator override; requires authorization, never automatic.
# TAXES_DEPLOYMENT_ENV=staging
# INVISIA_BROWSER_LEDGER_BYPASS=0
# INVISIA_BROWSER_STAGING_MAX_CAPTURES=1

# Optional Osceola Clerk native HTTP search through Scrape.do. Disabled by default.
SCRAPEDO_API_KEY=
INVISIA_OSCEOLA_CLERK_ENABLED=0

# Official intermediate chain for county servers that omit it; TLS checks remain enabled.
NODE_EXTRA_CA_CERTS=./vendor/tls/letsencrypt-yr2-chain.pem

# Durable single-operator lookups. Existing synchronous APIs remain available.
TAXES_JOBS_ENABLED=1
TAXES_SOURCE_REVISION=working-tree
# Optional local Chromium: install pinned Playwright in a reviewed deployment.
TAXES_LOCAL_BROWSER_ENABLED=0
# Optional absolute path to an installed Chromium; its sandbox remains enabled.
TAXES_LOCAL_BROWSER_EXECUTABLE_PATH=
# Optional licensed Python extraction; disabled until licensing is approved.
TAXES_PYMUPDF_ENABLED=0
TAXES_PYMUPDF_LICENSE_APPROVED=0
TAXES_PYTHON=python3
# Production requires an isolated, approved image (prefer a verified digest).
TAXES_PDF_CONTAINER_IMAGE=
# Optional Poppler/Tesseract OCR for pages with no extractable text; review-only.
# Does not require PyMuPDF. Production requires the isolated OCR image.
TAXES_OCR_ENABLED=0
TAXES_OCR_CONTAINER_IMAGE=

# Optional original-PDF binary ingress, using job-scoped one-use tickets.
# Configure Nginx artifact-ingest location before enabling this HTTPS origin.
TAXES_ARTIFACT_INGEST_ORIGIN=
# Explicit operator-authorized production recovery override; defaults off.
# Keep a reviewed county scope and record per-job provider receipts.
# INVISIA_BROWSER_OPERATOR_OVERRIDE=1
# INVISIA_BROWSER_OPERATOR_COUNTIES=miami-dade-fl,osceola-fl
